@TodoApi_HostAddress = http://localhost:5080

GET {{TodoApi_HostAddress}}/api/todos
Accept: application/json

###

# A blank Title is a 400 with a ProblemDetails body whose errors are keyed by field.
POST {{TodoApi_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "   ",
  "tagIds": []
}

###

# @name createTodo
POST {{TodoApi_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "  Buy milk  ",
  "description": "   ",
  "tagIds": []
}

###

# The requests below use the id of the Todo the POST above created, so send that first.
@todoId = {{createTodo.response.body.$.id}}

GET {{TodoApi_HostAddress}}/api/todos/{{todoId}}
Accept: application/json

###

PUT {{TodoApi_HostAddress}}/api/todos/{{todoId}}
Content-Type: application/json

{
  "title": "Buy oat milk",
  "description": "From the corner shop",
  "tagIds": []
}

###

# Sets the Status, never toggles it: sending this twice leaves the Todo Completed.
PUT {{TodoApi_HostAddress}}/api/todos/{{todoId}}/status
Content-Type: application/json

{
  "status": "Completed"
}

###

PUT {{TodoApi_HostAddress}}/api/todos/{{todoId}}/status
Content-Type: application/json

{
  "status": "Active"
}

###

# Only "Active" or "Completed", spelled exactly, is accepted: this is a 400 with a status error.
PUT {{TodoApi_HostAddress}}/api/todos/{{todoId}}/status
Content-Type: application/json

{
  "status": "completed"
}

###

DELETE {{TodoApi_HostAddress}}/api/todos/{{todoId}}

###

# After the DELETE above, this is a 404 with a ProblemDetails body.
GET {{TodoApi_HostAddress}}/api/todos/{{todoId}}
Accept: application/json

###

GET {{TodoApi_HostAddress}}/api/tags
Accept: application/json

###

# @name createTag
POST {{TodoApi_HostAddress}}/api/tags
Content-Type: application/json

{
  "name": "  work  "
}

###

# The same name in any case is a 409 with a ProblemDetails detail naming the existing Tag.
POST {{TodoApi_HostAddress}}/api/tags
Content-Type: application/json

{
  "name": "WORK"
}

###

# The requests below use the id of the Tag the POST createTag above made, so send that first.
@tagId = {{createTag.response.body.$.id}}

# A case-only rename is allowed: it isn't a duplicate of itself.
PUT {{TodoApi_HostAddress}}/api/tags/{{tagId}}
Content-Type: application/json

{
  "name": "Work"
}

###

# @name createTaggedTodo
POST {{TodoApi_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "Write the report",
  "tagIds": ["{{tagId}}", "{{tagId}}"]
}

###

# An id that isn't a Tag is a 400 whose tagIds error names it.
POST {{TodoApi_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "Write the report",
  "tagIds": ["00000000-0000-0000-0000-000000000000"]
}

###

DELETE {{TodoApi_HostAddress}}/api/tags/{{tagId}}

###

# After the DELETE above, the Todo is still here, with no Tags.
GET {{TodoApi_HostAddress}}/api/todos/{{createTaggedTodo.response.body.$.id}}
Accept: application/json

###
